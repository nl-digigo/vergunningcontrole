        </ids:property>
        <ids:property dataType="IFCAREAMEASURE" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/AreaPerOccupant" cardinality="required" instructions="Het BBL heeft minimale eisen voor sommige gebruiksfuncties.&#10;Bijvoorbeeld een kantoorfunctie is 0,05.&#10;Dit getal is de ten minste aan te houden aantal personen per m² verblijfsgebied.&#10;AreaPerOccupant is 1/eis = 1/0,05 | ILS 9.10c · RIR: geen tegenhanger">
          <ids:propertySet>
            <ids:simpleValue>Pset_SpaceOccupancyRequirements</ids:simpleValue>
          </ids:propertySet>
