<?xml version='1.0' encoding='UTF-8'?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>9.18m Fysieke elementen IfcTransportElement.ELEVATOR</ids:title>
    <ids:copyright>Vereniging Nederlandse Gemeenten</ids:copyright>
    <ids:version>0.3.0-concept</ids:version>
    <ids:description>Concept-deelspecificatie 48 voor de ILS Omgevingsvergunning. Nieuw voorgesteld op 23 november 2026; nog niet opgenomen in versie 0.2.0.</ids:description>
    <ids:author>lex.ransijn@vng.nl</ids:author>
    <ids:date>2026-11-23</ids:date>
    <ids:purpose>Indieningsvereisten van ruimte-modellering t.b.v. vergunningsaanvraag Omgevings Plan Activiteit (Omgevingsplan) en Technische Activiteit (Bbl) voor bouwwerken zijnde Gebouw — BM13-checks: #9, #10 (bron: BM13-regelinventarisatie v0.3, 3-7-2026).</ids:purpose>
    <ids:milestone>015-03 Inhoudelijk behandelen aanvraag / processtap Toetsen aan regelgeving (GEMMA Omgevingswet, bedrijfsproces 015 Behandelen aanvraag)</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="9.18m Fysieke elementen IfcTransportElement.ELEVATOR" identifier="9.18m" instructions="De lift als IfcTransportElement met PredefinedType ELEVATOR. De vrije maten van de liftkooi zijn nodig voor de toets aan artikel 4.182, zesde lid, van het Bbl.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCTRANSPORTELEMENT</ids:simpleValue>
          </ids:name>
          <ids:predefinedType>
            <ids:simpleValue>ELEVATOR</ids:simpleValue>
          </ids:predefinedType>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ClearWidth" cardinality="optional" instructions="Vrije breedte van de liftkooi.">
          <ids:propertySet>
            <ids:simpleValue>Pset_TransportElementElevator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ClearWidth</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ClearDepth" cardinality="optional" instructions="Vrije diepte van de liftkooi.">
          <ids:propertySet>
            <ids:simpleValue>Pset_TransportElementElevator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ClearDepth</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCPOSITIVELENGTHMEASURE" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ClearHeight" cardinality="optional" instructions="Vrije hoogte van de liftkooi.">
          <ids:propertySet>
            <ids:simpleValue>Pset_TransportElementElevator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ClearHeight</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/FireFightingLift" cardinality="optional" instructions="Indicatie of de lift een brandweerlift is.">
          <ids:propertySet>
            <ids:simpleValue>Pset_TransportElementElevator</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FireFightingLift</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCCOUNTMEASURE" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/CapacityPeople" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_TransportElementCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>CapacityPeople</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCBOOLEAN" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/FireExit" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_TransportElementCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>FireExit</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>
