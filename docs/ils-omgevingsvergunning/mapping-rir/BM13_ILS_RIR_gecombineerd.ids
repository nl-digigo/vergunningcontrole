          <ids:name>
            <ids:simpleValue>IFCPRODUCT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements description="Regulatory Life safety.Life safety.Product Requirement">
        <ids:property instructions="[RIR] Acoustic rating of airborne sounds in decibels. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AcousticRatingAirborne</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] Acoustic rating of external sounds in decibels. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AcousticRatingExternal</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] Acoustic rating of structural sounds in decibels. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AcousticRatingStructural</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is durable. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasDurableSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is even. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasEvenSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is firm. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasFirmSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The object is perforated. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasPerforatedSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is self draining. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasSelfDrainingSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is slip resistant. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasSlipResistantSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is slip resistant when dry. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasSlipResistantWhenDrySurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is slip resistant when wet. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasSlipResistantWhenWetSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The object bounds fire compartment(s). — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsCompartmental</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The object is part of a route from a building or space. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsForEgress</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The object is part of the route to a building or space. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsForIngress</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The fire rating requirement for the object. The rating may be the same or higher than that required by the regulation. The actual fire rating of the object may be equal to or higher than this requirement. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RequiredFireRating</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] A requirement for how the object reacts to fire. The rating may be the same or higher than the requirement of the rule. The actual rating of the object may be equal to or higher than this requirement. — informatief (optional)" cardinality="optional">
