            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>RequiredFireReaction</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The slip resistance class of the surface on which users move. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SlipResistanceGrade</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The moisture resistance class of the surface on which users move. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>SlipResistanceGradeWhenWet</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property instructions="[RIR] The surface on which users move is a hard material. — informatief (optional)" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_RegulatoryCondition</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>HasHardSurface</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
