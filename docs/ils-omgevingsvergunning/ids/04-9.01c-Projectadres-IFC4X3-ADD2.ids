<?xml version='1.0' encoding='UTF-8'?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>9.01c Projectadres (IFC4X3_ADD2)</ids:title>
    <ids:copyright>Vereniging Nederlandse Gemeenten</ids:copyright>
    <ids:version>0.2.0</ids:version>
    <ids:description>Deelspecificatie 04 van de ILS Omgevingsvergunning 0.2.0.</ids:description>
    <ids:author>lex.ransijn@vng.nl</ids:author>
    <ids:date>2026-11-17</ids:date>
    <ids:purpose>Indieningsvereisten van ruimte-modellering t.b.v. vergunningsaanvraag Omgevings Plan Activiteit (Omgevingsplan) en Technische Activiteit (Bbl) voor bouwwerken zijnde Gebouw — BM13-checks: #1, #2, #3, #4, #5, #6 (bron: BM13-regelinventarisatie v0.3, 3-7-2026).</ids:purpose>
    <ids:milestone>015-03 Inhoudelijk behandelen aanvraag / processtap Toetsen aan regelgeving (GEMMA Omgevingswet, bedrijfsproces 015 Behandelen aanvraag)</ids:milestone>
  </ids:info>
  <ids:specifications>
    <ids:specification ifcVersion="IFC4X3_ADD2" name="9.01c Projectadres (IFC4X3_ADD2)" identifier="9.01c" description="Projectadres in IFC4X3_ADD2 (LoGref10). Optioneel: vul het adres in bij een gebouw met een postadres; laat het leeg bij meerdere gebouwen of functies. De georeferentie op RD bepaalt de locatie. Meer informatie over Georefereren: https://geonovum.github.io/GeoBIM_Georefereren" instructions="Pset_Address bestaat vanaf IFC4X3. De adresattributen SiteAddress (IfcSite) en BuildingAddress (IfcBuilding) worden niet gevraagd.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSITE" />
              <xs:enumeration value="IFCBUILDING" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/AddressLines" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AddressLines</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/Country" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Country</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>NL</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/PostalCode" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PostalCode</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/Town" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Town</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  </ids:specifications>
</ids:ids>