						
PREFIX dso:    <http://vng.nl/areas/>

SELECT ?id ?group ?geometry
WHERE {
  GRAPH <areas.ttl> {
    ?area	a       dso:area ;
                  	dso:id    		?id ;
                  	dso:group  	    ?group ;
                  	dso:geometry  	?geometry .
    FILTER(?group = "wonen" || ?group = "gemengd")
  }
}
ORDER BY ?id
