          <ids:value>
            <ids:simpleValue>Gebruikseenheid</ids:simpleValue>
          </ids:value>
          <ids:system>
            <ids:simpleValue>Omgevingswet-Ruimten</ids:simpleValue>
          </ids:system>
        </ids:classification>
        <ids:attribute cardinality="required" instructions="Naam van de eenheid&#10;Voorbeeld Unit S-25 / Appartement 3&#10; | ILS 9.07 · RIR: Identification SpatialElement › Pset_PremisesRegulatory.PremisesID (Gelijke betekenis); Identification Space › Pset_SpaceCommon.UnitIdentifier (Gelijke betekenis); Identification Space › Pset_SpaceArea_Strata.Prop_StrataLotNumber (Deels / verwant); Identification Space › @Name (Exact); Life safety SpatialZone › @Name (Exact)">
          <ids:name>
