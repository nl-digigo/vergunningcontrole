<?xml version='1.0' encoding='UTF-8'?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <ids:info>
    <ids:title>ILS Omgevingsvergunning – gemapt op buildingSMART RIR</ids:title>
    <ids:copyright>buildingSMART RIR v2024-09-19 (CC BY-NC-SA 4.0) + ILS Omgevingsvergunning 0.2.0 (BM13-partners)</ids:copyright>
    <ids:version>0.2.0</ids:version>
    <ids:description>Combinatie van de buildingSMART Regulatory Information Delivery Specification (RIR, v2024-09-19) en de 41 deelspecificaties van de ILS Omgevingsvergunning 0.2.0. Deel A: de 41 NL-specificaties (NL-cardinaliteit leidend), per eis voorzien van de RIR-tegenhanger in instructions en aangevuld met RIR-eisen voor dezelfde IFC-klasse als optional. Deel B: RIR-specificaties zonder NL-tegenhanger, informatief (alle eisen optional). Mapping-details: BM13_ILS_RIR_mapping.xlsx.</ids:description>
    <ids:author>lex@vdcbase.com</ids:author>
    <ids:date>2026-11-17</ids:date>
    <ids:purpose>Vergelijking en afstemming NL-indieningsvereisten omgevingsvergunning met de internationale buildingSMART RIR</ids:purpose>
    <ids:milestone>015-03 Inhoudelijk behandelen aanvraag (GEMMA Omgevingswet)</ids:milestone>
  </ids:info>
  <ids:specifications><ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="NL 9 ILS Omgevingsvergunning ↔ RIR: Identification Space (Deels / verwant); Life safety SpatialZone (Deels / verwant); Identification SpatialElement (Deels / verwant)" identifier="https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.3.0" description="Om het aantal specificaties te beperken worden in deze specificatie vereisten benoemd die wel in IfcSpatialZone, IfcSpace en IfcExternalSpatialElement voorkomen maar niet in IfcZone. | Bron: 01-9.00-ILS-Omgevingsvergunning.ids. RIR-tegenhanger: Identification Space (Deels / verwant); Life safety SpatialZone (Deels / verwant); Identification SpatialElement (Deels / verwant)." instructions="NL-eisen behouden hun ILS-cardinaliteit; [RIR]-eisen zijn informatief.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
              <xs:enumeration value="IFCEXTERNALSPATIALELEMENT" />
              <xs:enumeration value="IFCZONE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="ILS 9 · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>GlobalId</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="ILS 9 · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
  <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="NL 9.01a Georeferentie ↔ RIR: geen RIR-tegenhanger" identifier="https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.3.0/class/Georeferentie" description="Georeferentie met IfcMapConversion of IfcMapConversionScaled. (LoGref50) Een BIM-Model moet de IFCClass IFCMAPCONVERSION of IFCMAPCONVERSIONSCALED bevatten; IFCMAPCONVERSIONSCALED bestaat alleen in IFC4X3 en is daar de aanbevolen route voor RD met NAP. De klasse heeft de attributen Easting, Northing, OrthogonalHeight, XAxisAbscissa, XAxisOrdinate en Scale ingevuld. Het model dient een SourceCRS en TargetCRS te hebben. Dit is echter niet te valideren d.m.v. IDS. Meer informatie over Georefereren: https://geonovum.github.io/GeoBIM_Georefereren | Bron: 02-9.01a-Georeferentie.ids. RIR-tegenhanger: geen RIR-tegenhanger." instructions="NL-eisen behouden hun ILS-cardinaliteit; [RIR]-eisen zijn informatief.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCMAPCONVERSION" />
              <xs:enumeration value="IFCMAPCONVERSIONSCALED" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Verplaatsing in Oostrichting om het BIM-model op de goede plek te krijgen.&#10;Voorbeeld: 92370.710706 | ILS 9.01a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>Eastings</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Verplaatsing in Noordrichting om het BIM-model op de goede plek te krijgen.&#10;Voorbeeld: 437455.379788 | ILS 9.01a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>Northings</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Verplaatsing in Hoogterichting om het BIM-model op de goede plek te krijgen.&#10;Voorbeeld: 1.3092 | ILS 9.01a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>OrthogonalHeight</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Specificeert de waarde langs de oostelijke as van het eindpunt van een vector die de positie van de lokale x-as van het engineering coördinaatreferentiesysteem aangeeft.&#10;Voorbeeld: 0.8 | ILS 9.01a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>XAxisAbscissa</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Specificeert de waarde langs de noordelijke as van het eindpunt van een vector die de positie van de lokale x-as van het engineering coördinaatreferentiesysteem aangeeft.&#10;Voorbeeld: 0.1 | ILS 9.01a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>XAxisOrdinate</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Schaal van eenheden in BIM-model t.o.v. eenheden in target CRS&#10;Voorbeeld: 1/0.001 | ILS 9.01a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>Scale</ids:simpleValue>
          </ids:name>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
  <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="NL 9.01b Coördinatenstelsel ↔ RIR: geen RIR-tegenhanger" identifier="https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.3.0/class/Coordinatenstelsel" description="Coördinatenstelsel op RD of RD+NAP (LoGref50). Het attribuut TargetCRS voor Nederlandse indiening is een IfcProjectedCRS met in Name EPSG:7415 (RD+NAP) of EPSG:28992 (RD). Bij EPSG:28992 is VerticalDatum EPSG:5709 (NAP); zie 9.01f. Meer informatie over Georefereren: https://geonovum.github.io/GeoBIM_Georefereren | Bron: 03-9.01b-Coordinatenstelsel.ids. RIR-tegenhanger: geen RIR-tegenhanger." instructions="Deze CRS-eis geldt alleen voor Nederlandse projecten waarbij de omvang van het project i.c.m. de kromming van de aarde geen probleem oplevert. Als dit niet geldt dan is het ook mogelijk om eventueel IfcGeographicCRS en/of andere EPSG te gebruiken.  IfcProjectedCRS kan geen Classificatie toegekend krijgen. https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.2.0/class/Cordinatenstelsel">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECTEDCRS</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Doel-coördinatenstelsel waarin het BIM-model geplaatst wordt, bij voorkeur EPSG:7415.&#10;Name is EPSG:7415 (RD+NAP) of EPSG:28992 (RD). Bij EPSG:28992 is VerticalDatum EPSG:5709 (NAP); zie 9.01f.&#10;https://www.opengis.net/def/crs/EPSG/0/28992 | ILS 9.01b · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EPSG:7415" />
              <xs:enumeration value="EPSG:28992" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
  <ids:specification ifcVersion="IFC4X3_ADD2" name="NL 9.01c Projectadres (IFC4X3_ADD2) ↔ RIR: Life safety Site (Gelijke betekenis); Identification Building (Deels / verwant)" identifier="9.01c" description="Projectadres in IFC4X3_ADD2 (LoGref10). Optioneel: vul het adres in bij een gebouw met een postadres; laat het leeg bij meerdere gebouwen of functies. De georeferentie op RD bepaalt de locatie. Meer informatie over Georefereren: https://geonovum.github.io/GeoBIM_Georefereren | Bron: 04-9.01c-Projectadres-IFC4X3-ADD2.ids. RIR-tegenhanger: Life safety Site (Gelijke betekenis); Identification Building (Deels / verwant)." instructions="Pset_Address bestaat vanaf IFC4X3. De adresattributen SiteAddress (IfcSite) en BuildingAddress (IfcBuilding) worden niet gevraagd.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSITE" />
              <xs:enumeration value="IFCBUILDING" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/AddressLines" cardinality="optional" instructions="ILS 9.01c · RIR: Life safety Site › Pset_Address.AddressLines (Exact); Identification Building › Pset_Address.BuildingAddress (Deels / verwant)">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>AddressLines</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/Country" cardinality="optional" instructions="ILS 9.01c · RIR: geen tegenhanger">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Country</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>NL</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/PostalCode" cardinality="optional" instructions="ILS 9.01c · RIR: Life safety Site › Pset_Address.PostalCode (Exact)">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>PostalCode</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/Town" cardinality="optional" instructions="ILS 9.01c · RIR: Life safety Site › Pset_Address.Town (Exact)">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Town</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="NL 9.01f Verticaal datum (NAP) ↔ RIR: geen RIR-tegenhanger" identifier="9.01f" description="Is de doel-CRS EPSG:28992 (RD zonder hoogtecomponent), dan is het verticale datum EPSG:5709 (NAP). De specificatie geldt alleen voor modellen met EPSG:28992. | Bron: 44-9.01f-Verticaal-datum.ids. RIR-tegenhanger: geen RIR-tegenhanger." instructions="Gebruik bij voorkeur EPSG:7415; die bevat de hoogtecomponent (NAP) al.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECTEDCRS</ids:simpleValue>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>EPSG:28992</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="ILS 9.01f · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>VerticalDatum</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>EPSG:5709</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:requirements>
    </ids:specification>
  <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="NL 9.02 Project ↔ RIR: Identification Project (Gelijke betekenis); Identification Building (Deels / verwant); Identification SpatialElement (Deels / verwant)" identifier="https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.3.0/class/Project" description="Een BIM-Model moet de IFCClass IfcProject bevatten zodat men de representationcontext heeft waar men t.o.v. IfcMapConversion de Local placement gedaan kan worden. Tevens kunnen er een aantal algemene eigenschappen worden ingevuld zoals de fase en het type project. | Bron: 07-9.02-Project.ids. RIR-tegenhanger: Identification Project (Gelijke betekenis); Identification Building (Deels / verwant); Identification SpatialElement (Deels / verwant). 1 RIR-eisen als optional toegevoegd." instructions="NL-eisen behouden hun ILS-cardinaliteit; [RIR]-eisen zijn informatief.">
      <ids:applicability minOccurs="1" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCPROJECT</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="Naam&#10;Voorbeeld: Woningbouwproject x, voortgezet onderwijs | ILS 9.02 · RIR: Identification Building › @ProjectTitle (Gelijke betekenis)">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="Toelichting&#10;Voorbeeld: Bouw van 5 rijwoningen, basisschool met kinderdagverblijf | ILS 9.02 · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>Description</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="optional" instructions="Fase volgens STB2025: Voorbeeld: 2.3 Definitief ontwerp&#10;Fase volgens STB2025: Voorbeeld: DO&#10;Fase volgens STB2014: Voorbeeld: 05 Definitief ontwerp | ILS 9.02 · RIR: Identification Project › Pset_BuildingSummary.ProjectPhase (Gelijke betekenis); Identification SpatialElement › Pset_RegulatoryIdentification.RegulatoryStage (Deels / verwant)">
          <ids:name>
            <ids:simpleValue>Phase</ids:simpleValue>
          </ids:name>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:pattern value="01 Initiatief/haalbaarheid|02 Projectdefinitie|03 Structuurontwerp|04 Voorontwerp|05 Definitief ontwerp|06 Technisch ontwerp/Bestek|07 Prijs- en Contractvorming|07 Prijs- en contractvorming|08 Uitvoering - Uitvoeringsgereed Ontwerp|09 Uitvoering - Directievoering|10 Gebruik/Exploitatie|1. Initiatief|1.1 Iniatief|INI|1.2 Haalbaarheid|HBH|1.3 Projectdefinitie|PD|2. Ontwerp|2.1 Structuurontwerp|SO|2.2 Voorontwerp|VO|2.3 Definitief Ontwerp|DO|2.4 Omgevingsvergunning|OV|3. Engineering|3.1 Technisch Ontwerp|TO|3.2 Uitvoeringsgereed Ontwerp|UO|4. Realisatie|4.1 Uitvoering|UV|4.2 Oplevering &amp; Overdracht|OO|4.3 Onderhoudstermijn|5. Gebruik" />
            </xs:restriction>
          </ids:value>
        </ids:attribute>
        <ids:property dataType="IFCLABEL" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ProjectType" cardinality="optional" instructions="ILS 9.02 · RIR: Identification Building › Pset_ProjectDesignParameter.ProjectNature (Gelijke betekenis); Identification SpatialElement › Pset_RegulatoryIdentification.ConstructionActivityType (Gelijke betekenis); Identification Building › Pset_BuildingSummary.ConstructionActivityDescription (Deels / verwant)">
          <ids:propertySet>
            <ids:simpleValue>Pset_ProjectCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProjectType</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="NEWBUILD" />
              <xs:enumeration value="MODIFICATION" />
              <xs:enumeration value="OPERATIONMAINTENANCE" />
              <xs:enumeration value="RENOVATION" />
              <xs:enumeration value="REPAIR" />
            </xs:restriction>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCMONETARYMEASURE" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/ProjectInvestmentEstimate" cardinality="optional" instructions="Stichtingskosten: NEN2699 Niveau 1 : A t/m G&#10;Voorbeeld: 1000000 | ILS 9.02 · RIR: geen tegenhanger">
          <ids:propertySet>
            <ids:simpleValue>Pset_ProjectCommon</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProjectInvestmentEstimate</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      <ids:property instructions="[RIR Identification Project] Project phase — informatief (optional) overgenomen uit buildingSMART RIR" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_BuildingSummary</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>ProjectPhase</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  <ids:specification ifcVersion="IFC4X3_ADD2 IFC4" name="NL 9.03a Perceel ↔ RIR: Life safety Site (Gelijke betekenis)" identifier="https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.3.0/class/Perceel" description="Perceel als IfcSite. IfcSite is onderdeel van de ruimtelijke hiërarchie in het IfcSchema. Dit is een administratief component en kan geen geometrie bevatten. | Bron: 08-9.03a-Perceel.ids. RIR-tegenhanger: Life safety Site (Gelijke betekenis). 1 RIR-eisen als optional toegevoegd." instructions="Indien het project een Kadastraal Perceel bevat zijn de eigenschappen in Pset_LandRegistration verplicht.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <ids:simpleValue>IFCSITE</ids:simpleValue>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:attribute cardinality="required" instructions="ILS 9.03a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>Name</ids:simpleValue>
          </ids:name>
        </ids:attribute>
        <ids:attribute cardinality="required" instructions="ILS 9.03a · RIR: geen tegenhanger">
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Perceel</ids:simpleValue>
          </ids:value>
        </ids:attribute>
        <ids:property dataType="IFCBOOLEAN" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/IsPermanentID" cardinality="required" instructions="ILS 9.03a · RIR: Identification SpatialElement › Pset_PremisesRegulatory.IsPermanentID (Deels / verwant)">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>IsPermanentID</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <ids:simpleValue>true</ids:simpleValue>
          </ids:value>
        </ids:property>
        <ids:property dataType="IFCIDENTIFIER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/LandID" cardinality="optional" instructions="identificatieLokaalID uit Pset_LandRegistration&#10;voorbeeld: 19650000670000 | ILS 9.03a · RIR: Life safety Site › Pset_LandRegistration.LandID (Exact)">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LandID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
        <ids:property dataType="IFCIDENTIFIER" uri="https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/prop/LandTitleID" cardinality="optional" instructions="ILS 9.03a · RIR: Life safety Site › Pset_LandRegistration.LandID (Deels / verwant)">
          <ids:propertySet>
            <ids:simpleValue>Pset_LandRegistration</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>LandTitleID</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      <ids:property instructions="[RIR Life safety Site] Indication of the purpose of this object. — informatief (optional) overgenomen uit buildingSMART RIR" cardinality="optional">
          <ids:propertySet>
            <ids:simpleValue>Pset_Address</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Purpose</ids:simpleValue>
          </ids:baseName>
        </ids:property>
      </ids:requirements>
    </ids:specification>
  <ids:specification ifcVersion="IFC4 IFC4X3_ADD2" name="NL 9.03b Bouwwerkperceel ↔ RIR: DefinedType GeographicElement (Deels / verwant); DefinedType Annotation (Deels / verwant)" identifier="https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.3.0/class/Bouwwerkperceel" description="Bouwwerkperceel als IfcZone, IfcSpace of IfcSpatialZone. | Bron: 09-9.03b-Bouwwerkperceel.ids. RIR-tegenhanger: DefinedType GeographicElement (Deels / verwant); DefinedType Annotation (Deels / verwant)." instructions="Een IfcSpace of IfcSpatialZone is gemodelleerd. Een IfcZone is een container die één of meerdere IfcSpaces of IfcSpatialZones bevat. Op deze manier kan één geometrie zowel het Bouwwerkperceel als het Kadastraal Perceel representeren.">
      <ids:applicability minOccurs="0" maxOccurs="unbounded">
        <ids:entity>
          <ids:name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCSPATIALZONE" />
              <xs:enumeration value="IFCSPACE" />
              <xs:enumeration value="IFCZONE" />
            </xs:restriction>
          </ids:name>
        </ids:entity>
        <ids:attribute>
          <ids:name>
            <ids:simpleValue>ObjectType</ids:simpleValue>
          </ids:name>
          <ids:value>
            <ids:simpleValue>Bouwwerkperceel</ids:simpleValue>
          </ids:value>
        </ids:attribute>
      </ids:applicability>
      <ids:requirements>
        <ids:classification uri="https://identifier.buildingsmart.org/uri/bsnl/Omgevingswet-Ruimten/0.3.0/class/Bouwwerkperceel" cardinality="optional" instructions="ILS 9.03b · RIR: geen tegenhanger">
          <ids:value>
            <ids:simpleValue>Bouwwerkperceel</ids:simpleValue>
          </ids:value>
          <ids:system>
